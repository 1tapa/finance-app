# Copie este arquivo para ".env" e preencha com SUAS credenciais do Dashboard Pluggy.
# NUNCA suba o arquivo ".env" pro GitHub nem compartilhe em prints.
# Se suas chaves antigas já apareceram em algum lugar (print, chat, etc), regenere-as antes de usar aqui.
#
# Em produção (Render), essas mesmas 4 variáveis vão no painel de "Environment",
# não em arquivo nenhum.

PLUGGY_CLIENT_ID=cole_seu_client_id_aqui
PLUGGY_CLIENT_SECRET=cole_seu_client_secret_aqui
PLUGGY_ITEM_IDS=cole_os_itemIds_separados_por_virgula_aqui
PORT=3001
